__pycache__/
*.py[cod]
*$py.class
.venv/
env/
.DS_Store
*.log
node_modules/
build/
bin/
obj/
*.user
*.suo
informes/

# verificacion/ guarda dos cosas distintas:
#   - almacenamiento local de pruebas (DWGs, evidencias, logs sueltos) -> NO se versiona
#   - la telemetria que alimenta el dashboard -> SI se versiona, es el "medidor de
#     confianza" (cuantas veces se uso cada skill). Si se ignora entera, cualquier
#     clon nuevo arranca en "0 usos / Sin uso" y pierde el historial.
# Nota: hay que excluir el CONTENIDO (verificacion/*), no la carpeta, porque git no
# puede re-incluir archivos dentro de un directorio ya excluido.
verificacion/*
!verificacion/skill_usage.json
!verificacion/matriz.csv
!verificacion/session_logs.json

# De graphify solo se ignora la cache de AST: contiene rutas absolutas de la maquina
# que la genero y no debe viajar entre PCs (se regenera sola).
# El RESTO de graphify-out/ SI se versiona: graph.json alimenta el panel de grafo del
# dashboard (update_dashboard.py -> get_graphify_stats), asi que si se ignora entero,
# ese panel aparece vacio en cualquier clon nuevo.
graphify-out/cache/

# Respaldos del bundle de Civil 3D creados por server/scripts/deploy-plugin.ps1
*.bundle.bak/

# NOTA: server/C_References/ SI se versiona a proposito. Son las 5 DLLs de Civil 3D
# que necesita el .csproj (HintPath = ..\C_References) para compilar el plugin.
# Mantenerlas dentro del repo es lo que permite clonar y compilar en cualquier PC.
